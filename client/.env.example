# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# "mock"  -> fully in-browser mock API + mock auth (no backend needed)
# "api"   -> talk to the Express server at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Auth (only used when NEXT_PUBLIC_DATA_MODE=api)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_CLIENT_ID=
