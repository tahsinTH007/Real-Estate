PORT=3002

# PostgreSQL with the PostGIS extension enabled
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentiful?schema=public"

# AWS S3 — property photo uploads
AWS_REGION=us-east-2
S3_BUCKET_NAME=

# AWS Cognito — when set, bearer tokens are cryptographically verified.
# Leave blank for local development to accept unverified (decoded) tokens.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
